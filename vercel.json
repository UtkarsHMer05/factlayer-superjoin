{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "VITE_OUT_DIR=../public npm ci --prefix frontend && VITE_OUT_DIR=../public npm run build --prefix frontend",
  "outputDirectory": "public",
  "functions": {
    "api/index.py": {
      "includeFiles": "public/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {"source": "/api/:path*", "destination": "/api/index.py"},
    {"source": "/:path*", "destination": "/api/index.py"}
  ]
}
