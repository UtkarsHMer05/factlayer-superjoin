# Copy to .env. Keep the real key server-side and out of git/front-end builds.
# A nonempty key selects the OpenAI-compatible remote API adapter.
FACT_MODEL=deepseek/deepseek-v4-flash
FACT_MODEL_URL=https://api.xkiro.com/v1
FACT_API_KEY=
FACT_DATA_DIR=data
FACT_REQUEST_TIMEOUT=300
FACT_STREAM_IDLE_TIMEOUT=180
FACT_THINKING_MODE=enabled
FACT_REASONING_EFFORT=low
FACT_MAX_OUTPUT_TOKENS=8192
FACT_MODEL_RETRY_COOLDOWN_SECONDS=65
# Per-job cap; 0 means unlimited. The UI shows budget stops as partial.
FACT_MAX_REQUESTS=1000
FACT_MAX_TOKENS=1000000
FACT_SAMPLE_MODE=false
FACT_READ_ONLY=false
# Shared-workspace abuse guardrails. Set either request value to 0 to disable locally.
FACT_UPLOAD_RATE_LIMIT=5
FACT_RESUME_RATE_LIMIT=6
FACT_RATE_LIMIT_WINDOW_SECONDS=60

# OpenRouter free-router test configuration (replace the three fields above).
# It may select a different free model per request, so pin a model for any
# reproducible final evaluation.
# FACT_MODEL=liquid/lfm-2.5-2.6b:free
# FACT_MODEL_URL=https://openrouter.ai/api/v1
# FACT_API_KEY=your_openrouter_key
