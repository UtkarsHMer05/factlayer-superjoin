# Copy to .env. Keep the real key server-side and out of git/front-end builds.
# A nonempty key selects the OpenAI-compatible remote API adapter.
FACT_MODEL=z-ai/glm-5.3-free
FACT_MODEL_URL=https://api.tokenrouter.com/v1
FACT_API_KEY=
FACT_DATA_DIR=data
FACT_REQUEST_TIMEOUT=180
FACT_REASONING_EFFORT=low
FACT_MAX_OUTPUT_TOKENS=10000
# Per-job cap; 0 means unlimited. The UI shows budget stops as partial.
FACT_MAX_REQUESTS=1000
FACT_MAX_TOKENS=1000000
FACT_SAMPLE_MODE=false
