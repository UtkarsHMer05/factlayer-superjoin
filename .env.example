# Copy to .env. Existing Ollama login is used; no credentials belong in this file.
FACT_MODEL=gpt-oss:120b-cloud
FACT_MODEL_URL=http://127.0.0.1:11434
FACT_DATA_DIR=data
FACT_REQUEST_TIMEOUT=120
# Per-job cap; 0 means unlimited. The UI shows budget stops as partial.
FACT_MAX_REQUESTS=1000
FACT_MAX_TOKENS=1000000
FACT_ENABLE_OCR=false
